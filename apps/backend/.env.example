# Configuración del backend — copiar a `.env` y ajustar.
# NUNCA commitear `.env` con valores reales (está en .gitignore).

# Base de datos (SQLite archivo local)
DATABASE_URL="file:./prisma/mutualmetrics.db"

# Puerto del backend
PORT=3000

# Orígenes permitidos por CORS (coma-separado)
CORS_ORIGIN="http://localhost:4200,http://localhost:8080"

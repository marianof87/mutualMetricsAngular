// Schema de Prisma — MutualMetrics
//
// Cada dueño de slice agrega aquí los modelos que necesita.
// Regla: nombres en español (PascalCase para modelos, camelCase para campos).
// Regla: después de agregar/modificar un modelo, correr:
//   npm run prisma:migrate -- --name <descripcion-corta>
// Eso genera la migración SQL en prisma/migrations/ (se commitea al repo).
//
// Modelos pendientes por slice:
//   Slice 1 (Auth/Usuarios):  Usuario
//   Slice 4 (Historial):      Escenario (FK a Usuario)
//   Slice 5 (Novedades):      Novedad, Contacto

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Slice 5 (Novedades & Contacto)
// ------------------------------------------------------------------

model Novedad {
  id           String   @id @default(uuid())
  titulo       String
  contenido    String
  imagenUrl    String?
  fechaCreacion DateTime @default(now())
}

model Contacto {
  id         String   @id @default(uuid())
  nombre     String
  email      String
  mensaje    String
  recibidoEn DateTime @default(now())
}

// Lead Magnet — leads capturados por el informe gated (descarga de PDF).
model Lead {
  id           String   @id @default(uuid())
  nombre       String
  empresa      String
  whatsapp     String
  email        String
  recibidoEn   DateTime @default(now())
  simulaciones SimulacionActuarial[]
}

// Resultado resumido de una corrida actuarial (Monte Carlo), vinculada a un Lead.
model SimulacionActuarial {
  id                 String   @id @default(uuid())
  leadId             String?
  lead               Lead?    @relation(fields: [leadId], references: [id])

  // Parámetros clave (resumen)
  coeficienteBTipo   String   // "fijo" | "estocástico"
  nSimulaciones      Int
  nivelConfianza     Float

  // Resultados resumidos
  precioOptimoMedia  Float
  precioOptimoP5     Float
  precioOptimoP95    Float
  pisoSolvencia      Float?
  probPerdidaOptimo  Float
  probPerdidaActual  Float?

  simuladoEn         DateTime @default(now())
}
model Optimizacion {
  id                 String   @id @default(uuid())
  coeficienteA       Float
  coeficienteB       Float
  coeficienteC       Float
  precioMinimo       Float
  precioMaximo       Float
  precioOptimo       Float
  gananciaMaxima     Float
  estrategiaSugerida String
  calculadoEn        DateTime @default(now())
}

// Slice 1 (Auth/Usuarios). Base para Slice 4 (Escenario tendrá FK a Usuario).
model Usuario {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  nombre       String
  creadoEn     DateTime @default(now())
  escenarios   Escenario[]
}

// ------------------------------------------------------------------
// Slice 4 (Historial) — Escenario
// ------------------------------------------------------------------

// Escenario: resultado persistido de un c�lculo del usuario (p.ej. cuadr�tica o
// pricing). inputs/outputs se guardan como JSON serializado (SQLite no tiene
// tipo JSON nativo); el DTO Zod valida su estructura al leer/escribir.
model Escenario {
  id         String   @id @default(uuid())
  usuarioId  String
  tipo       String // "cuadratica" | "pricing" (validado en DTO Zod)
  inputs     String // JSON serializado de los datos de entrada
  outputs    String // JSON serializado de los resultados
  creadoEn   DateTime @default(now())

  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, creadoEn])
}
// Schema de Prisma — MutualMetrics
//
// Cada dueño de slice agrega aquí los modelos que necesita.
// Regla: nombres en español (PascalCase para modelos, camelCase para campos).
// Regla: después de agregar/modificar un modelo, correr:
//   npm run prisma:migrate -- --name <descripcion-corta>
// Eso genera la migración SQL en prisma/migrations/ (se commitea al repo).
//
// Modelos pendientes por slice:
//   Slice 1 (Auth/Usuarios):  Usuario
//   Slice 4 (Historial):      Escenario (FK a Usuario)
//   Slice 5 (Novedades):      Novedad

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Modelo de ejemplo (sección Contacto).
// Los otros dueños pueden eliminar esto y empezar con sus propios modelos.
// ------------------------------------------------------------------

model Contacto {
  id         String   @id @default(uuid())
  nombre     String
  email      String
  mensaje    String
  recibidoEn DateTime @default(now())
}

model Escenario {
  id          String   @id @default(uuid())
  titulo      String
  descripcion String
  datos       String   // Guardamos acá los datos del escenario o métricas en formato JSON (texto)
  creadoEn    DateTime @default(now())
}
{
  "name": "mutual-metrics",
  "version": "0.1.0",
  "private": true,
  "description": "Metrix IA — proyecto académico Angular + NestJS (monorepo).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "npm-run-all --sequential build:shared dev:all",
    "dev:all": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "npm --workspace @mutual-metrics/frontend run start",
    "dev:backend": "npm --workspace @mutual-metrics/backend run start:dev",
    "build": "npm-run-all --sequential build:shared build:backend build:frontend",
    "build:shared": "npm --workspace @mutual-metrics/shared run build",
    "build:backend": "npm --workspace @mutual-metrics/backend run build",
    "build:frontend": "npm --workspace @mutual-metrics/frontend run build",
    "test": "npm-run-all --parallel test:frontend test:backend test:shared",
    "test:frontend": "npm --workspace @mutual-metrics/frontend run test -- --watch=false",
    "test:backend": "npm --workspace @mutual-metrics/backend run test",
    "test:shared": "npm --workspace @mutual-metrics/shared run test",
    "test:cov": "npm-run-all --parallel test:cov:shared test:cov:backend",
    "test:cov:shared": "npm --workspace @mutual-metrics/shared run test:cov",
    "test:cov:backend": "npm --workspace @mutual-metrics/backend run test:cov",
    "lint": "npm-run-all --parallel lint:frontend lint:backend",
    "lint:frontend": "npm --workspace @mutual-metrics/frontend run lint --if-present",
    "lint:backend": "npm --workspace @mutual-metrics/backend run lint --if-present",
    "prisma:generate": "npm --workspace @mutual-metrics/backend run prisma:generate",
    "prisma:migrate": "npm --workspace @mutual-metrics/backend run prisma:migrate",
    "prisma:studio": "npm --workspace @mutual-metrics/backend run prisma:studio",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "podman:up": "podman compose up --build",
    "podman:down": "podman compose down"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^8.57.0",
    "npm-run-all": "^4.1.5"
  }
}
